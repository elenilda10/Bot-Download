+  "collection.stopped": "⏸️ <b>{title}</b>: stopped due to a service limit or Telegram error.\nSent: {sent} · Failed: {failed} · Unavailable: {unavailable} · Remaining: {remaining}",
+  "collection.error": "❌ Could not load or complete this collection."
 }
